\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Target-reachability proof DAG. Public textbook data enter only at [1]. Nodes [2]--[6] generate the total graphs, source algebra, compactification, target quotient, and total shell graph. Its ordinary value gives unit progress at [7], while every boundary value enters [14]. Thus [8] forces aligned support. Nodes [9]--[11] close the divergent-price branch. Every ordinary or graph-boundary value also enters [14]; finite price joins it at [15]. Every invoked relation is restricted and source-factorized at [16] before it feeds the ordered cone at [17]. A checked finite identity gives [12]; the complementary order-unit functional gives the zero-price resaturation state at [18]. Target-local polarity splitting, target-cyclic adjoint generation, covariant valuation, defect polarization, and prospective reselection return it to [14] with strictly larger resolved-prefix rank whenever a target-active cell remains. A cofinal refinement is evaluated by diagonal target-aligned saturation. Only a closed same-origin realization of every generated relation is an actual singular mechanism. No semantic compact-set assertion is used as an exclusion proof, and no live node is an unexpanded analytic label.}}{10}{figure.1}\protected@file@percent }
\newlabel{fig:target-local-physical-proof}{{1}{10}{Target-reachability proof DAG. Public textbook data enter only at [1]. Nodes [2]--[6] generate the total graphs, source algebra, compactification, target quotient, and total shell graph. Its ordinary value gives unit progress at [7], while every boundary value enters [14]. Thus [8] forces aligned support. Nodes [9]--[11] close the divergent-price branch. Every ordinary or graph-boundary value also enters [14]; finite price joins it at [15]. Every invoked relation is restricted and source-factorized at [16] before it feeds the ordered cone at [17]. A checked finite identity gives [12]; the complementary order-unit functional gives the zero-price resaturation state at [18]. Target-local polarity splitting, target-cyclic adjoint generation, covariant valuation, defect polarization, and prospective reselection return it to [14] with strictly larger resolved-prefix rank whenever a target-active cell remains. A cofinal refinement is evaluated by diagonal target-aligned saturation. Only a closed same-origin realization of every generated relation is an actual singular mechanism. No semantic compact-set assertion is used as an exclusion proof, and no live node is an unexpanded analytic label}{figure.1}{}}
\newlabel{fig:target-local-physical-proof@cref}{{[figure][1][]1}{[1][7][]10}{}{}{}}
