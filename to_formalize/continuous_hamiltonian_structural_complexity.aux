\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Constructive singularity evaluator. Only the target-active quotient is analyzed. If it contains no singularity-aligned structure, normalized shell contact is impossible. Otherwise the surviving source class is evaluated structurally: divergent physical price excludes it, while finite price forces ordered first-failure routing and a recurrent zero-production law. The viability recursion then generates either a finite rational-cylinder pruning transcript or an infinite zero-price path supporting the displayed singularity mechanism.}}{79}{figure.20}\protected@file@percent }
\newlabel{fig:structural-regularity-compiler}{{20}{79}{Constructive singularity evaluator. Only the target-active quotient is analyzed. If it contains no singularity-aligned structure, normalized shell contact is impossible. Otherwise the surviving source class is evaluated structurally: divergent physical price excludes it, while finite price forces ordered first-failure routing and a recurrent zero-production law. The viability recursion then generates either a finite rational-cylinder pruning transcript or an infinite zero-price path supporting the displayed singularity mechanism}{figure.20}{}}
\newlabel{fig:structural-regularity-compiler@cref}{{[figure][20][]20}{[1][78][]79}{}{}{}}
