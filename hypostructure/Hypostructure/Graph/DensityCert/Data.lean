import Hypostructure.Graph.DensityCert.Checker

/-!
# Density certificate: the block list

`blockStr` lists, in graph6, the 5519 two-connected admissible graphs on 3 to 21
vertices (one per line, sorted by order).  `LArr` is `K₂` followed by these graphs,
each decoded into row bitmasks (`CG.ofG6Rows`), and `Lcert` is its list.
-/

namespace Hypostructure.Graph.DensityCert

/-- Decode a graph6 string directly into row bitmasks. -/
def CG.ofG6Rows (s : String) : CG :=
  let cs : Array ℕ := (s.toList.map fun c => c.toNat - 63).toArray
  let n := cs.getD 0 0
  let rows : Array ℕ := Id.run do
    let mut rows := Array.replicate n 0
    let mut k := 0
    for j in [1:n] do
      for i in [0:j] do
        if (cs.getD (1 + k / 6) 0).testBit (5 - k % 6) then
          rows := rows.modify i (· ||| (1 <<< j))
          rows := rows.modify j (· ||| (1 <<< i))
        k := k + 1
    return rows
  ⟨n, fun i j => (rows.getD i 0).testBit j⟩

