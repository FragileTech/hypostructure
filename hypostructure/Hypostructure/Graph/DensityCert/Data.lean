/-- `K₂` followed by the 5519 blocks. -/
def LArr : Array CG :=
  #[CG.K2] ++ ((blockStr.splitOn "\n").map fun s => CG.ofG6Rows s).toArray

/-- The certified list: `K₂` and the 5519 two-connected admissible blocks. -/
def Lcert : List CG := LArr.toList

theorem K2_mem_Lcert : CG.K2 ∈ Lcert := by
  unfold Lcert LArr
  rw [Array.toList_append]
  exact List.mem_append_left _ (by simp)

end Hypostructure.Graph.DensityCert
